---
import { semuaJadwal } from "../lib/paket";
import { namaBulan } from "../lib/tanggal";
import Ikon from "./Ikon.astro";

// Cuma meneruskan pilihan ke halaman jadwal lewat query string.
const jadwal = await semuaJadwal();
const bulan = [...new Set(jadwal.map((j) => j.bulan))].sort();
---
<form class="cari" action="/jadwal/" method="get">
  <label class="cari__medan">
    <span>Budget per orang</span>
    <select name="harga">
      <option value="">Berapa saja</option>
      <option value="murah">Di bawah Rp1 juta</option>
      <option value="sedang">Rp1 – 3 juta</option>
      <option value="mahal">Di atas Rp3 juta</option>
    </select>
  </label>
  <label class="cari__medan">
    <span>Bulan berangkat</span>
    <select name="bulan">
      <option value="">Kapan saja</option>
      {bulan.map((b) => <option value={b}>{namaBulan(b)}</option>)}
    </select>
  </label>
  <label class="cari__medan">
    <span>Ketersediaan</span>
    <select name="tersedia">
      <option value="1">Hanya yang masih tersedia</option>
      <option value="">Tampilkan semua</option>
    </select>
  </label>
  <button class="btn btn--wa cari__tombol" type="submit">
    <Ikon nama="cari" /> Cari trip
  </button>
</form>
