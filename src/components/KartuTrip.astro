---
import type { Jadwal } from "../lib/paket";
import { batchAktif } from "../lib/paket";
import { kunciBulan } from "../lib/tanggal";
import { rupiah } from "../lib/wa";
import Ikon from "./Ikon.astro";

interface Props {
  jadwal: Jadwal;
}

const { jadwal } = Astro.props;
const { paket, batch, tanggal } = jadwal;
const d = paket.data;

// Kartu mewakili satu paket, bukan satu keberangkatan. Yang ditampilkan
// tanggal terdekat; sisanya dihitung jadi keterangan "+N tanggal lagi".
const semuaBatch = batchAktif(paket);
const tanggalLain = semuaBatch.length - 1;
const adaTersedia = semuaBatch.some((b) => b.kuotaSisa > 0);

// Filter di halaman jadwal menyaring per paket, jadi atributnya memuat
// semua bulan yang dipunyai paket ini, bukan cuma bulan terdekat.
const bulanPaket = [...new Set(semuaBatch.map((b) => kunciBulan(b.mulai)))].join(" ");
const termurah = Math.min(...semuaBatch.map((b) => b.harga));
---
<a
  class:list={["kartu", !adaTersedia && "kartu--penuh"]}
  href={`/paket/${paket.id}/`}
  data-baris
  data-destinasi={d.destinasi}
  data-bulan={bulanPaket}
  data-harga={termurah}
  data-sisa={adaTersedia ? 1 : 0}
>
  <div class="kartu__foto">
    <span class="kartu__durasi"><Ikon nama="jam" /> {d.durasi}</span>
    <img src={d.foto} alt={`Suasana trip ${d.nama} di ${d.lokasi}`} loading="lazy" width="900" height="560" />
  </div>

  <div class="kartu__isi">
    <div class="kartu__chip">
      <span class="chip chip--tanggal">{tanggal}</span>
      {tanggalLain > 0 && <span class="chip chip--lain">+{tanggalLain} tanggal lagi</span>}
      <span class={`chip chip--${adaTersedia ? "tersedia" : "penuh"}`}>
        {adaTersedia ? "TERSEDIA" : "KUOTA PENUH"}
      </span>
    </div>

    <h3 class="kartu__judul">{d.nama}</h3>
    <p class="kartu__ringkas">{d.ringkas}</p>

    <div class="kartu__kaki">
      <div class="kartu__harga">
        {batch.hargaCoret && <s>{rupiah(batch.hargaCoret)}</s>}
        <strong>{rupiah(batch.harga)}</strong>
      </div>
      <span class="kartu__perorang">per orang</span>
    </div>
  </div>
</a>
