---
import { FITUR } from "../data/konten";
import { batchAktif, catatanHarga, hargaMulaiDari, hargaBervariasi, masihTersedia, type Paket } from "../lib/paket";
import { kunciBulan } from "../lib/tanggal";
import { rupiah } from "../lib/wa";
import Ikon from "./Ikon.astro";
import Manifes from "./Manifes.astro";

interface Props {
  paket: Paket;
}

const { paket } = Astro.props;
const d = paket.data;

// Dua baris cukup untuk kartu. Sisanya dihitung jadi satu keterangan di kaki,
// supaya tinggi kartu tetap sejajar dalam grid berapa pun jumlah batch-nya.
const BARIS_KARTU = 2;

const batch = batchAktif(paket);
const tanggalLain = Math.max(batch.length - BARIS_KARTU, 0);
const tersedia = masihTersedia(paket);

const harga = hargaMulaiDari(paket);
const mulaiDari = hargaBervariasi(paket);

// Atribut filter. Tanpa jadwal cuma harga yang dipakai.
const bulanPaket = [...new Set(batch.map((b) => kunciBulan(b.mulai)))].join(" ");
---
<a
  class:list={["kartu", !tersedia && "kartu--penuh"]}
  href={`/paket/${paket.id}/`}
  data-baris
  data-destinasi={d.destinasi}
  data-bulan={bulanPaket}
  data-harga={harga ?? 0}
  data-sisa={tersedia ? 1 : 0}
>
  <div class="kartu__foto">
    <span class="kartu__durasi"><Ikon nama="jam" /> {d.durasi}</span>
    <img src={d.foto} alt={`Suasana trip ${d.nama} di ${d.lokasi}`} loading="lazy" width="1200" height="675" />
  </div>

  <div class="kartu__isi">
    <h3 class="kartu__judul">{d.nama}</h3>
    <p class="kartu__ringkas">{d.ringkas}</p>

    {FITUR.jadwal && batch.length > 0 && (
      <Manifes batch={batch} batas={BARIS_KARTU} />
    )}

    {!FITUR.jadwal && (
      <div class="kartu__chip">
        <span class="chip chip--tanggal">{d.lokasi}</span>
        <span class="chip chip--lain">Level {d.level}</span>
      </div>
    )}

    <div class="kartu__kaki">
      {FITUR.jadwal ? (
        tanggalLain > 0 && <span class="kartu__perorang">+{tanggalLain} tanggal lagi</span>
      ) : (
        <div class="kartu__harga">
          {harga !== null
            ? <strong>{mulaiDari ? `mulai ${rupiah(harga)}` : rupiah(harga)}</strong>
            : <strong class="kartu__harga--tanya">Tanya harga</strong>}
          <span class="kartu__perorang">{catatanHarga(paket) || "per orang"}</span>
        </div>
      )}
      <span class="kartu__tautan">Lihat detail <Ikon nama="panah" /></span>
    </div>
  </div>
</a>
