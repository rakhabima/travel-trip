---
import Dasar from "../layouts/Dasar.astro";
import KartuTrip from "../components/KartuTrip.astro";
import FilterJadwal from "../components/FilterJadwal.astro";
import Ikon from "../components/Ikon.astro";
import { BRAND, KEBIJAKAN } from "../data/konten";
import { jadwalPerPaket, semuaJadwal } from "../lib/paket";
import { namaBulan } from "../lib/tanggal";
import { waLink } from "../lib/wa";

const jadwal = await jadwalPerPaket();
const semua = await semuaJadwal();

// Judul rentang diambil dari keberangkatan pertama dan terakhir supaya
// tidak perlu diedit tiap kali batch baru masuk.
const bulan = [...new Set(semua.map((j) => j.bulan))].sort();
const rentang =
  bulan.length > 1 ? `${namaBulan(bulan[0])} – ${namaBulan(bulan[bulan.length - 1])}` : namaBulan(bulan[0] ?? "");
---
<Dasar
  judul="Jadwal Trip"
  deskripsi="Jadwal open trip terbaru: tanggal, harga per orang, dan fasilitas yang termasuk. Booking langsung lewat WhatsApp."
  gambar="https://images.unsplash.com/photo-1531761535209-180857e963b9?auto=format&fit=crop&w=1200&q=80"
>

  <section class="hero hero--halaman">
    <div class="hero__bg" style="background-image:url('https://images.unsplash.com/photo-1531761535209-180857e963b9?auto=format&fit=crop&w=1600&q=80')"></div>
    <div class="wadah hero__isi">
      <span class="eyebrow">Jadwal Trip</span>
      <h1>Semua keberangkatan yang sedang dibuka</h1>
      <p class="hero__lead">
        {jadwal.length} tujuan dan {semua.length} tanggal keberangkatan. Kursi kamu aman setelah DP masuk. Jika ada
        perubahan tanggal karena cuaca, kamu pasti dikabari lebih dulu.
      </p>
    </div>
  </section>

  <section class="seksi">
    <div class="wadah">
      <div class="seksi-kepala">
        <span class="eyebrow">{rentang}</span>
        <h2>Pilih tanggal keberangkatan disini</h2>
        <p>Harga yang tertera berlaku per orang. Semua pemesanan dan pembayaran dikoordinasikan lewat WhatsApp, tidak ada form atau pembayaran di website ini.</p>
      </div>

      <FilterJadwal />

      <p class="filter__hasil" data-hasil aria-live="polite">
        {jadwal.length} tujuan ditampilkan dari total {jadwal.length}.
      </p>

      <div class="grid-trip" data-grid-jadwal>
        {jadwal.map((j) => <KartuTrip jadwal={j} />)}
      </div>

      <div class="kosong" data-kosong hidden>
        <p class="kosong__judul">Belum ada trip yang cocok.</p>
        <p class="kosong__isi">
          Coba longgarkan filternya. Atau chat saja — kadang kami buka batch tambahan
          kalau ada yang minta duluan.
        </p>
        <a class="btn btn--wa" target="_blank" rel="noopener"
           href={waLink("Halo, saya mau tanya tanggal trip yang belum ada di jadwal.")}
           data-kosong-wa={`https://wa.me/${BRAND.waNomor}?text=`}>
          <Ikon nama="wa" /> Tanya tanggal lain
        </a>
      </div>

      <div class="dua-kolom mt-l">
        <div class="panel panel--senja">
          <h3>Alur pemesanan</h3>
          <ol style="margin:0;padding-left:20px;color:var(--tinta-lembut);font-size:.95rem">
            <li>Chat WhatsApp, sebutkan nama trip dan jumlah orang.</li>
            <li>Admin akan cek sisa kuota dan kirim rincian.</li>
            <li>DP {KEBIJAKAN.dp} untuk mengamankan kursi ({KEBIJAKAN.dpTenggat}).</li>
            <li>Pelunasan {KEBIJAKAN.pelunasan}.</li>
            <li>{KEBIJAKAN.grupWa}</li>
          </ol>
        </div>
        <div class="panel">
          <h3>Mau tanggal sendiri?</h3>
          <p style="color:var(--tinta-lembut);font-size:.95rem">
            Semua rute di atas bisa dijalankan sebagai private trip mulai 6 orang. Tanggal, itinerary,
            dan tipe penginapan menyesuaikan permintaan. Cocok untuk rombongan kantor, keluarga, atau
            teman.
          </p>
          <a class="btn btn--wa" href={waLink("Halo, saya mau tanya private trip. Rencana ... orang, sekitar tanggal ... , tujuan ...")} target="_blank" rel="noopener">
            <Ikon nama="wa" /> Minta penawaran private trip
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="seksi seksi--rapat">
    <div class="wadah">
      <div class="cta">
        <div class="cta__teks">
          <h2>Kuota berubah setiap hari</h2>
          <p>Kursi kamu sudah aman setelah DP masuk. Kalau tanggalnya sudah pasti, lebih aman konfirmasi dulu lewat chat sebelum atur cuti dan tiket pesawat.</p>
        </div>
        <div class="cta__aksi">
          <a class="btn btn--wa" href={waLink("Halo, saya mau cek trip yang masih tersedia untuk bulan ini.")} target="_blank" rel="noopener">
            <Ikon nama="wa" /> Cek ketersediaan
          </a>
          <a class="btn btn--garis-terang" href="/itinerary/">Lihat contoh itinerary</a>
        </div>
      </div>
    </div>
  </section>

</Dasar>
