---
import { getCollection } from "astro:content";
import Dasar from "../layouts/Dasar.astro";
import Ikon from "../components/Ikon.astro";
import { semuaPaket, batchTerdekat, statusKuota } from "../lib/paket";
import { rentangPendek } from "../lib/tanggal";
import { rupiah, waLink, waPaket } from "../lib/wa";

// Tiga penyebab halaman ini bisa kosong, dan ketiganya butuh perbaikan yang
// berbeda — jadi dibedakan pesannya, jangan digabung.
const semua = await getCollection("paket");
if (semua.length === 0) {
  throw new Error(
    "Koleksi paket kosong. Kalau berkas di src/content/paket/ ada isinya, kemungkinan besar cache konten basi: hentikan dev server, jalankan `rm -rf .astro`, lalu `npm run dev`."
  );
}

// semuaPaket() membuang paket yang seluruh keberangkatannya sudah lewat.
const paket = await semuaPaket();
if (paket.length === 0) {
  throw new Error(
    "Semua keberangkatan sudah lewat. Tambah tanggal baru di src/content/paket/*.md, atau perbarui yang lama."
  );
}

// Prioritaskan paket bertanda unggulan; kalau tidak ada, ambil paket pertama
// yang punya itinerary.
const trip =
  paket.find((p) => p.data.unggulan && p.data.itinerary.length > 0) ??
  paket.find((p) => p.data.itinerary.length > 0);

if (!trip) {
  throw new Error(
    "Ada paket aktif, tapi tidak satu pun punya itinerary. Isi field `itinerary` di salah satu src/content/paket/*.md"
  );
}

const d = trip.data;
const batch = batchTerdekat(trip);
const subjudul = d.highlight.join(" · ");
---
<Dasar
  judul={`Itinerary ${d.nama}`}
  deskripsi={`Itinerary hari per hari trip ${d.nama}: ${subjudul}.`}
  gambar={d.foto}
>

  <section class="hero hero--halaman">
    <div class="hero__bg" style={`background-image:url('${d.foto}')`}></div>
    <div class="wadah hero__isi">
      <span class="eyebrow">Trip unggulan</span>
      <h1>{d.nama}</h1>
      <p class="hero__lead">{subjudul}</p>
      <div class="hero__aksi">
        <a class="btn btn--wa" href={waLink(waPaket(d.nama))} target="_blank" rel="noopener">
          <Ikon nama="wa" /> Booking trip ini via WhatsApp
        </a>
        <a class="btn btn--garis-terang" href="/jadwal/">Lihat tanggal keberangkatan</a>
      </div>
    </div>
  </section>

  <section class="seksi seksi--rapat">
    <div class="wadah">
      <div class="trust" style="margin-top:-70px">
        <div class="trust__item">
          <span class="trust__angka">{d.durasi}</span>
          <span class="trust__label">Durasi trip</span>
        </div>
        {batch && (
          <div class="trust__item">
            <span class="trust__angka">{rupiah(batch.harga)}</span>
            <span class="trust__label">Per orang, {batch.hargaCatatan}</span>
          </div>
        )}
        {batch && (
          <div class="trust__item">
            <span class="trust__angka">Maks. {batch.kuotaTotal}</span>
            <span class="trust__label">Peserta per keberangkatan</span>
          </div>
        )}
        {batch && (
          <div class="trust__item">
            <span class="trust__angka">{rentangPendek(batch.mulai, batch.selesai)}</span>
            <span class="trust__label">Batch terdekat · {statusKuota(batch).teks.toLowerCase()}</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="seksi" style="padding-top:0">
    <div class="wadah dua-kolom" style="grid-template-columns:1.5fr 1fr;align-items:start;gap:40px">

      <div>
        <div class="seksi-kepala">
          <span class="eyebrow">Rundown harian</span>
          <h2>Dari darat sampai balik lagi</h2>
        </div>

        <div class="itin">
          {d.itinerary.map((h) => (
            <section class="itin__hari">
              <span class="itin__titik"></span>
              <span class="itin__label">{h.label}</span>
              <h3 class="itin__tema">{h.tema}</h3>
              <p class="itin__lokasi"><Ikon nama="pin" /> {h.lokasi}</p>
              <ul class="itin__agenda">
                {h.agenda.map((a) => (
                  <li><span class="itin__jam">{a.jam}</span><span>{a.isi}</span></li>
                ))}
              </ul>
            </section>
          ))}
        </div>

        {d.catatanItinerary && (
          <div class="panel panel--senja" style="margin-top:30px">
            <h3>Catatan penting</h3>
            <p style="margin:0;color:var(--tinta-lembut);font-size:.95rem">{d.catatanItinerary}</p>
          </div>
        )}
      </div>

      <aside style="display:grid;gap:20px;position:sticky;top:calc(var(--nav-h) + 20px)">
        <div class="panel">
          <h3>Sudah termasuk</h3>
          <ul class="cek-list">
            {d.include.map((i) => <li><Ikon nama="cek" /><span>{i}</span></li>)}
          </ul>
        </div>

        <div class="panel">
          <h3>Belum termasuk</h3>
          <ul class="cek-list" style="--x:1">
            {d.exclude.map((i) => (
              <li><span style="color:var(--pasir-400);margin-top:2px">✕</span><span>{i}</span></li>
            ))}
          </ul>
        </div>

        <div class="panel">
          <h3>Bawaan wajib</h3>
          <ul class="tag-list">
            {d.bawa.map((b) => <li>{b}</li>)}
          </ul>
        </div>

        <figure class="foto">
          <img src="https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=800&q=80" alt="Perahu tradisional di perairan tenang" loading="lazy" />
          <figcaption>Kapal yang dipakai selama sailing</figcaption>
        </figure>

        <div class="panel" style="background:var(--laut-800);border-color:var(--laut-800)">
          <h3 style="color:var(--pasir-100)">Siap ikut?</h3>
          <p style="color:rgba(251,243,230,.75);font-size:.94rem">Sebutkan tanggal batch yang kamu mau, admin cek kuotanya langsung.</p>
          <a class="btn btn--wa btn--blok" href={waLink(`Halo, saya mau ikut trip ${d.nama}. Untuk batch tanggal ... , apakah masih ada kursi?`)} target="_blank" rel="noopener">
            <Ikon nama="wa" /> Booking via WhatsApp
          </a>
          <a class="btn btn--garis-terang btn--blok" href="/jadwal/" style="margin-top:10px">
            <Ikon nama="panah-kiri" /> Kembali ke jadwal trip
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="seksi seksi--rapat laut terang">
    <div class="wadah">
      <div class="seksi-kepala">
        <span class="eyebrow">Galeri rute ini</span>
        <h2>Suasana di trip {d.lokasi}</h2>
      </div>
      <div class="galeri">
        <figure class="foto"><img src="https://images.unsplash.com/photo-1559128010-7c1ad6e1b6a5?auto=format&fit=crop&w=800&q=80" alt="Pulau kecil berbukit di tengah laut" loading="lazy" /><figcaption>Sunrise Pulau Padar</figcaption></figure>
        <figure class="foto"><img src="https://images.unsplash.com/photo-1518509562904-e7ef99cdcc86?auto=format&fit=crop&w=800&q=80" alt="Teluk berpasir dengan air jernih" loading="lazy" /><figcaption>Pink Beach</figcaption></figure>
        <figure class="foto"><img src="https://images.unsplash.com/photo-1573790387438-4da905039392?auto=format&fit=crop&w=800&q=80" alt="Pesisir berbatu dengan laut biru" loading="lazy" /><figcaption>Trekking di Pulau Komodo</figcaption></figure>
        <figure class="foto"><img src="https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&w=800&q=80" alt="Penyelam di antara gerombolan ikan" loading="lazy" /><figcaption>Snorkeling Manta Point</figcaption></figure>
      </div>
    </div>
  </section>

</Dasar>
