---
import Dasar from "../layouts/Dasar.astro";
import Testimoni from "../components/Testimoni.astro";
import Ikon from "../components/Ikon.astro";
import { BRAND } from "../data/konten";
import { waLink } from "../lib/wa";
---
<Dasar
  judul="Tentang Kami"
  deskripsi="Siapa yang menjalankan trip, bagaimana cara kami kerja, dan apa kata peserta sebelumnya."
  gambar="https://images.unsplash.com/photo-1590523278191-995cbcda646b?auto=format&fit=crop&w=1200&q=80"
>

  <section class="hero hero--halaman">
    <div class="hero__bg" style="background-image:url('https://images.unsplash.com/photo-1590523278191-995cbcda646b?auto=format&fit=crop&w=1600&q=80')"></div>
    <div class="wadah hero__isi">
      <span class="eyebrow">Tentang</span>
      <h1>Bukan agen besar. Cuma dua orang yang memang suka jalan.</h1>
      <p class="hero__lead">
        Setiap trip diurus dan didampingi langsung oleh orang yang sama dari awal chat sampai foto dibagikan.
      </p>
    </div>
  </section>

  <section class="seksi">
    <div class="wadah profil">
      <figure class="foto profil__foto foto--polos">
        <img src="https://images.unsplash.com/photo-1604999565976-8913ad2ddb7c?auto=format&fit=crop&w=800&q=80" alt="Trip leader duduk menghadap teluk saat memandu trip" loading="lazy" />
      </figure>
      <div>
        <span class="eyebrow">Yang menjalankan</span>
        <h2>{BRAND.adminNama} &amp; Ayu</h2>
        <p style="color:var(--tinta-lembut)">
          {BRAND.nama} dimulai tahun {BRAND.sejak} dari kebiasaan mengajak
          teman-teman patungan sewa kapal. Lama-lama yang ikut makin banyak dan bukan teman sendiri lagi, jadi kami rapikan:
          jadwalnya tetap, harganya jelas, dan pesertanya dibatasi supaya suasananya tetap seperti jalan sama teman.
        </p>
        <p style="color:var(--tinta-lembut)">
          Sampai hari ini masih dua orang. {BRAND.adminNama} pegang perencanaan rute dan chat WhatsApp,
          Ayu jadi trip leader di lapangan sekaligus yang memotret. Untuk urusan kapal, jeep, dan guide lokal, kami pakai
          partner tetap yang sudah kerja bareng bertahun-tahun.
        </p>
        <blockquote class="profil__kutip">
          &ldquo;Kami lebih suka satu kapal isi 16 orang yang semuanya kenal nama satu sama lain, daripada tiga kapal penuh yang
          cuma jadi angka.&rdquo;
        </blockquote>
        <ul class="tag-list">
          <li>Basis di {BRAND.kota}</li>
          <li>Sejak {BRAND.sejak}</li>
          <li>{BRAND.statTrip} trip berjalan</li>
          <li>{BRAND.statPeserta} peserta</li>
          <li>Maks. 16 orang per trip</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="seksi laut laut--pola terang">
    <div class="wadah">
      <div class="seksi-kepala">
        <span class="eyebrow">Prinsip kerja</span>
        <h2>Tiga hal yang tidak kami kompromikan</h2>
      </div>
      <div class="kontak-grid">
        <div class="kontak-kartu">
          <span class="kontak-kartu__ikon"><Ikon nama="orang" /></span>
          <span class="kontak-kartu__nilai">Grup tetap kecil</span>
          <p style="color:rgba(246,250,253,.72);font-size:.93rem;margin:6px 0 0">
            Kuota tidak pernah ditambah di menit terakhir, walaupun ada yang mau bayar lebih.
          </p>
        </div>
        <div class="kontak-kartu">
          <span class="kontak-kartu__ikon"><Ikon nama="tas" /></span>
          <span class="kontak-kartu__nilai">Harga apa adanya</span>
          <p style="color:rgba(246,250,253,.72);font-size:.93rem;margin:6px 0 0">
            Yang tidak termasuk ditulis di depan, bukan disebut belakangan pas sudah di lokasi.
          </p>
        </div>
        <div class="kontak-kartu">
          <span class="kontak-kartu__ikon"><Ikon nama="perisai" /></span>
          <span class="kontak-kartu__nilai">Aman dulu</span>
          <p style="color:rgba(246,250,253,.72);font-size:.93rem;margin:6px 0 0">
            Kalau cuaca tidak mendukung, rute diubah atau trip ditunda. Uang peserta tidak hangus.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="seksi">
    <div class="wadah">
      <div class="seksi-kepala">
        <span class="eyebrow">Kata peserta</span>
        <h2>Cerita dari yang sudah ikut</h2>
        <p>Ditulis ulang dari chat dan ulasan Instagram, dipakai dengan izin.</p>
      </div>
      <Testimoni />
    </div>
  </section>

  <section class="seksi seksi--rapat" style="padding-top:0">
    <div class="wadah">
      <div class="galeri">
        <figure class="foto"><img src="https://images.unsplash.com/photo-1488646953014-85cb44e25828?auto=format&fit=crop&w=800&q=80" alt="Kamera, peta, dan tas di atas meja" loading="lazy" /><figcaption>Persiapan sebelum berangkat</figcaption></figure>
        <figure class="foto foto--lebar"><img src="https://images.unsplash.com/photo-1531761535209-180857e963b9?auto=format&fit=crop&w=1200&q=80" alt="Teluk dengan perahu-perahu dilihat dari ketinggian" loading="lazy" /><figcaption>Trip sebelumnya</figcaption></figure>
        <figure class="foto"><img src="https://images.unsplash.com/photo-1509233725247-49e657c54213?auto=format&fit=crop&w=800&q=80" alt="Pantai dengan pohon kelapa" loading="lazy" /><figcaption>Briefing pagi di pantai</figcaption></figure>
      </div>
    </div>
  </section>

  <section class="seksi seksi--rapat">
    <div class="wadah">
      <div class="cta">
        <div class="cta__teks">
          <h2>Mau kenalan dulu sebelum daftar?</h2>
          <p>Boleh banget. Chat saja, tanya apa pun soal trip, rute, atau kondisi di lapangan.</p>
        </div>
        <div class="cta__aksi">
          <a class="btn btn--wa" href={waLink("Halo, saya baru baca halaman Tentang di website. Boleh tanya-tanya dulu soal tripnya?")} target="_blank" rel="noopener">
            <Ikon nama="wa" /> Chat WhatsApp
          </a>
          <a class="btn btn--garis-terang" href="/jadwal/">Lihat jadwal trip</a>
        </div>
      </div>
    </div>
  </section>

</Dasar>
