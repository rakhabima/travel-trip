---
import Dasar from "../layouts/Dasar.astro";
import Testimoni from "../components/Testimoni.astro";
import Legalitas from "../components/Legalitas.astro";
import Ikon from "../components/Ikon.astro";
import { BRAND, LEGALITAS } from "../data/konten";
import { waLink } from "../lib/wa";
---
<Dasar
  judul="Tentang Kami"
  deskripsi="Siapa yang menjalankan trip, bagaimana cara kami kerja, dan dokumen legalitas yang bisa kamu cek sendiri."
  gambar="https://images.unsplash.com/photo-1590523278191-995cbcda646b?auto=format&fit=crop&w=1200&q=80"
>

  <section class="hero hero--halaman">
    <div class="hero__bg" style="background-image:url('https://images.unsplash.com/photo-1590523278191-995cbcda646b?auto=format&fit=crop&w=1600&q=80')"></div>
    <div class="wadah hero__isi">
      <h1>Liburan santai tapi di-manage dengan serius</h1>
      <p class="hero__lead">
        Maksimal 16 orang, liburan asik bisa dapet teman baru.
      </p>
    </div>
  </section>

  <section class="seksi">
    <div class="wadah profil">
      <figure class="foto profil__foto foto--polos">
        <img src="https://images.unsplash.com/photo-1604999565976-8913ad2ddb7c?auto=format&fit=crop&w=800&q=80" alt="Trip leader duduk menghadap teluk saat memandu trip" loading="lazy" />
      </figure>
      <div>
        <h2>Ombak Lepas</h2>
        <p>
          Ombak Lepas mulai dari trip kecil ke Karimunjawa tahun 2019. awalnya bukan bisnis, hanya cara kami sendiri menikmati laut tanpa ribet mengurus logistik sendirian. Ternyata banyak yang cocok dengan cara kami jalan: grup kecil, serta biaya dan jadwal yang jelas. Dari situlah cara jalan-jalan itu kami rapikan jadi layanan tetap.
        </p>
        <p>
          Prinsip kerja kami sederhana: satu tim, satu alur, dari awal sampai selesai. Tidak ada pengalihan ke CS yang berbeda atau kru lapangan yang berganti tiap trip. Chat kamu, penyusunan rute, sampai dokumentasi di lapangan ditangani oleh orang yang sama.
        </p>
        <p>
          Kenapa maksimal 16 orang? Karena di atas angka itu, kualitas pengalamannya mulai turun — trip leader kewalahan mengawasi semua orang di air, dan giliran di spot foto jadi lebih lama. Jadi walaupun permintaan menambah kuota cukup sering masuk, jawabannya tetap sama: kuota tidak ditambah, supaya semua orang tetap kebagian.
        </p>
        <p>
          Kapal, kendaraan, dan penginapan yang kami pakai berasal dari mitra lokal yang sudah bertahun-tahun kami ajak kerja sama. Bukan soal mencari yang termurah, tapi yang sudah teruji dan memahami standar kerja kami.
        </p>
        <blockquote class="profil__kutip">
          &ldquo;Buat kami, satu kapal berisi 16 orang yang saling kenal lebih berarti daripada tiga kapal penuh yang cuma jadi statistik.&rdquo;
        </blockquote>
      </div>
    </div>
  </section>

  {LEGALITAS.badanUsaha && (
    <section class="seksi seksi--rapat">
      <div class="wadah wadah--sempit">
        <div class="seksi-kepala">
          <h2>Cek dulu, baru transfer</h2>
          <p>
            Cukup banyak open trip yang dijalankan lewat akun Instagram dan rekening pribadi. Supaya kamu bisa memastikan sendiri sebelum mengirim uang, berikut dokumen resmi kami beserta nomornya.
          </p>
        </div>
        <Legalitas />
      </div>
    </section>
  )}

  <section class="seksi">
    <div class="wadah">
      <div class="seksi-kepala">
        <h2>Kata mereka yang sudah ikut</h2>
      </div>
      <Testimoni />
    </div>
  </section>


  <section class="seksi seksi--rapat">
    <div class="wadah">
      <div class="cta">
        <div class="cta__teks">
          <h2>Mau kenalan dulu sebelum daftar?</h2>
          <p>Boleh banget. Chat saja, tanya apa pun soal trip, rute, atau kondisi terbaru di lapangan.</p>
        </div>
        <div class="cta__aksi">
          <a class="btn btn--wa" href={waLink("Halo, saya baru baca halaman Tentang. Boleh tanya-tanya dulu soal tripnya?")} target="_blank" rel="noopener">
            <Ikon nama="wa" /> Chat WhatsApp
          </a>
          <a class="btn btn--garis-terang" href="/paket/">Lihat jadwal trip</a>
        </div>
      </div>
    </div>
  </section>

</Dasar>
