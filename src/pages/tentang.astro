---
import Dasar from "../layouts/Dasar.astro";
import Testimoni from "../components/Testimoni.astro";
import Legalitas from "../components/Legalitas.astro";
import Ikon from "../components/Ikon.astro";
import { BRAND, LEGALITAS } from "../data/konten";
import { waLink } from "../lib/wa";
---
<Dasar
  judul="Tentang Kami"
  deskripsi="Siapa yang menjalankan trip, bagaimana cara kami kerja, dan dokumen legalitas yang bisa kamu cek sendiri."
  gambar="https://images.unsplash.com/photo-1590523278191-995cbcda646b?auto=format&fit=crop&w=1200&q=80"
>

  <section class="hero hero--halaman">
    <div class="hero__bg" style="background-image:url('https://images.unsplash.com/photo-1590523278191-995cbcda646b?auto=format&fit=crop&w=1600&q=80')"></div>
    <div class="wadah hero__isi">
      <h1>Tim kami hanya berdua dan keduanya selalu turun ke lapangan.</h1>
      <p class="hero__lead">
        Dari chat pertamamu sampai foto trip dibagikan, semuanya kami tangani sendiri, berdua.
      </p>
    </div>
  </section>

  <section class="seksi">
    <div class="wadah profil">
      <figure class="foto profil__foto foto--polos">
        <img src="https://images.unsplash.com/photo-1604999565976-8913ad2ddb7c?auto=format&fit=crop&w=800&q=80" alt="Trip leader duduk menghadap teluk saat memandu trip" loading="lazy" />
      </figure>
      <div>
        <h2>{BRAND.adminNama} &amp; Ayu</h2>
        <p>
          Bermula dari tahun {BRAND.sejak}, dari kebiasaan mengajak teman patungan sewa kapal ke
          Karimunjawa. Lama-kelamaan yang ikut makin banyak, dan bukan lagi orang-orang yang kami
          kenal langsung. Sejak itu kami rapikan semuanya: jadwal yang tetap, harga yang ditulis
          lengkap di depan, dan jumlah peserta yang kami batasi supaya rasanya tetap seperti jalan
          bareng teman, bukan rombongan wisata.
        </p>
        <p>
          Sampai sekarang tim kami masih berdua. {BRAND.adminNama} mengatur rute dan membalas
          WhatsApp, Ayu mendampingi langsung di lapangan sekaligus memotret. Kalau kamu chat
          sebelum berangkat, orang yang sama itu pula yang akan kamu temui di titik kumpul.
        </p>
        <p>
          Angka 16 bukan sekadar angka jualan. Di atas jumlah itu, satu trip leader sudah
          kesulitan memperhatikan semua orang di air, dan antrean di spot foto mulai terasa.
          Kami pernah diminta menambah kuota, dan kami menolak. Itu sebabnya beberapa batch
          tutup lebih cepat dari yang seharusnya.
        </p>
        <p>
          Kapal, jeep, dan homestay bukan milik kami sendiri. Semuanya berasal dari partner lokal
          yang sudah lama bekerja sama dengan kami. Bukan sekadar yang termurah, tapi yang sudah
          kami kenal dan pahami cara kerjanya.
        </p>
        <blockquote class="profil__kutip">
          &ldquo;Kami lebih memilih satu kapal berisi 16 orang yang saling kenal nama,
          daripada tiga kapal penuh yang cuma jadi angka.&rdquo;
        </blockquote>
      </div>
    </div>
  </section>

  {LEGALITAS.badanUsaha && (
    <section class="seksi seksi--rapat">
      <div class="wadah wadah--sempit">
        <div class="seksi-kepala">
          <h2>Cek dulu, baru transfer</h2>
          <p>
            Banyak open trip dijalankan dari akun Instagram dan rekening pribadi. Ini dokumen
            kami beserta nomornya, biar kamu bisa memastikan sendiri sebelum kirim uang.
          </p>
        </div>
        <Legalitas />
      </div>
    </section>
  )}

  <section class="seksi">
    <div class="wadah">
      <div class="seksi-kepala">
        <h2>Kata mereka yang sudah ikut</h2>
      </div>
      <Testimoni />
    </div>
  </section>


  <section class="seksi seksi--rapat">
    <div class="wadah">
      <div class="cta">
        <div class="cta__teks">
          <h2>Mau kenalan dulu sebelum daftar?</h2>
          <p>Boleh banget. Chat saja, tanya apa pun soal trip, rute, atau kondisi terbaru di lapangan.</p>
        </div>
        <div class="cta__aksi">
          <a class="btn btn--wa" href={waLink("Halo, saya baru baca halaman Tentang. Boleh tanya-tanya dulu soal tripnya?")} target="_blank" rel="noopener">
            <Ikon nama="wa" /> Chat WhatsApp
          </a>
          <a class="btn btn--garis-terang" href="/paket/">Lihat jadwal trip</a>
        </div>
      </div>
    </div>
  </section>

</Dasar>
